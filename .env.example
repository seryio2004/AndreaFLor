# Copiar como .env y ajustar. No guardar aquí contraseñas: la cuenta del panel se crea con `npm run owner -- <usuario>`.

# Servidor
HOST=127.0.0.1
PORT=3000
# production activa cookies Secure, HSTS y desactiva el formulario público por defecto.
NODE_ENV=development

# Ruta del archivo SQLite (se crea con las migraciones al arrancar).
DATABASE_PATH=data/flores.db

# Sesiones del panel (horas).
SESSION_IDLE_HOURS=2
SESSION_ABSOLUTE_HOURS=12

# Formulario público: off | test | live
# live solo arranca con datos comerciales en public/config.js, aviso revisado y HTTPS.
PUBLIC_FORM=test
PRIVACY_NOTICE_APPROVED=no

# Detrás de un proxy inverso con HTTPS (Caddy, nginx):
# TRUST_PROXY=true
# SECURE_COOKIES=true
