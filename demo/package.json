  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "1.48.2",
    "postcss": "8.5.31",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
